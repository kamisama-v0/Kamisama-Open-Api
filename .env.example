# ===========================================
# Database — Supabase (Postgres)
# Ambil dari Supabase Dashboard → Settings → Database
# ===========================================
# Pooler (port 6543) → dipakai aplikasi saat runtime
# Contoh: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:6543/postgres?pgbouncer=true
DATABASE_URL=
# Direct (port 5432) → dipakai prisma migrate/seed
# Contoh: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:6543/postgres
# (ganti port ke 5432, tanpa ?pgbouncer=true)
DIRECT_URL=

PORT=3000

# In-app DB heartbeat (Supabase Free anti-pause).
# Aktif otomatis saat NODE_ENV=production. Paksa on/off: true/false.
# Interval default 10 menit (600000 ms).
KEEPALIVE_ENABLED=
KEEPALIVE_INTERVAL_MS=600000

# URL publik backend (untuk generate link file upload, dsb.)
BASE_URL=http://localhost:3000
# URL frontend (CORS + trustedOrigins Better-Auth)
FRONTEND_URL=http://localhost:5173
# Origin exact extension WatchTracker (ID stabil via "key" di manifest.json)
# Contoh: chrome-extension://gfklpfphohjaldapnhijmpolmadmpcne
EXTENSION_ORIGIN=
# Origin tambahan (comma-separated) — mis. URL onrender.com sementara
# sebelum DNS custom domain pindah. Contoh: EXTRA_ORIGINS=https://kamisama-xxx.onrender.com
EXTRA_ORIGINS=

# ===========================================
# SMTP — Brevo di prod, Mailpit lokal default (kosongkan semua = Mailpit).
# PENTING: pakai SMTP key, BUKAN API v3 key.
# Brevo dashboard → SMTP & API → tab SMTP → Generate a new SMTP key.
# SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_SECURE=false (STARTTLS).
# SMTP_USER = email login Brevo, SMTP_PASS = SMTP key (xkeysib-...).
# MAIL_FROM harus sender yang sudah diverifikasi
# (Senders, domains & dedicated IPs) — kalau belum, Brevo menolak kirim.
# ===========================================
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ===========================================
# Better-Auth
# ===========================================
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000/api/auth

# JWT (legacy / cadangan)
JWT_ACCESS_SECRET=yoursecret
JWT_REFRESH_SECRET=yourrefreshsecret

# ===========================================
# Firebase Admin (khusus WatchTracker — Firestore)
# Dari Firebase Console → Project Settings → Service accounts
# → Generate new private key (file service-account.json)
# PRIVATE_KEY: copy nilai "private_key", ganti newline asli dengan \n
# Firestore: aktifkan mode production, region asia-southeast1
# Index: firebase deploy --only firestore:indexes (lihat firestore.indexes.json)
# ===========================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ===========================================
# iPaymu (payment vendor — sandbox)
# ===========================================
IPAYMU_VA=
IPAYMU_API_KEY=
