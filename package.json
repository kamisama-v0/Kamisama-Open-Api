{
	"name": "kamisama-open-api",
	"version": "1.1.0",
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"dev": "bun run --watch src/index.ts",
		"build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile ./server ./src/index.ts",
		"start": "bun run --watch src/index.ts",
		"auth:generate": "bun x @better-auth/cli generate --config src/libs/auth.ts",
		"auth:migrate": "bun x @better-auth/cli migrate",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:studio": "prisma studio",
		"db:seed": "bun prisma/seed.ts",
		"db:push": "prisma db push"
	},
	"dependencies": {
		"@better-auth/cli": "^1.4.21",
		"@elysiajs/bearer": "^1.4.4",
		"@elysiajs/cors": "^1.4.2",
		"@elysiajs/jwt": "^1.4.2",
		"@elysiajs/static": "^1.4.10",
		"@elysiajs/swagger": "^1.3.1",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"@types/crypto-js": "^4.2.2",
		"@types/nodemailer": "^8.0.1",
		"axios": "^1.20.0",
		"better-auth": "^1.7.2",
		"crypto-js": "^4.2.0",
		"elysia": "^1.4.30",
		"firebase-admin": "^14.3.0",
		"nodemailer": "^9.1.1",
		"pg": "^8.23.0",
		"prisma": "^7.10.0",
		"xss": "^1.0.15"
	},
	"devDependencies": {
		"@types/pg": "^8.23.1",
		"bun-types": "^1.4.0"
	},
	"module": "src/index.js"
}
